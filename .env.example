# Copy to .env and fill in. .env is gitignored and must never be committed.
# Credentials are read from your environment only - nothing is stored in the repo.

# Only needed for the bundled Claude backend.
ANTHROPIC_API_KEY=

# Only needed for the openai-compatible backend (OpenAI, Gemini, Groq, Mistral,
# OpenRouter, ...). A local server such as Ollama needs no key.
OPENAI_API_KEY=
# MULTIRAG_OPENAI_BASE_URL=https://api.openai.com/v1
# MULTIRAG_OPENAI_MODEL=

# Keys can instead be typed into the Streamlit sidebar, where they live only in
# that browser session's memory. Environment variables avoid retyping them.

# Optional. Defaults: claude / claude-opus-5. Use "echo" to run with no provider.
# Backends: echo, claude, openai-compatible.
# MULTIRAG_GENERATOR=echo
# MULTIRAG_GENERATOR_MODEL=claude-opus-5
